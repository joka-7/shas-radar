{
  "name": "shas-radar-model-picker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The React <ModelPicker> island mounted into static/index.html's AI settings dialog -- the app's only frontend build step. Its output (static/vendor/model-picker/) is committed like any other static asset; running the app itself (pip install + uvicorn) still needs no Node.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "modeldispatcher-browser-agent": "^0.6.7",
    "modeldispatcher-react-ui": "^0.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0"
  }
}
